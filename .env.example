# Chat, embeddings, and reranking connect independently to their providers.
# Supply credentials authorized for the selected endpoints and models.
CHAT_BASE_URL=https://api.deepseek.com/v1
CHAT_MODEL=deepseek-v4-flash
CHAT_API_KEY=replace-me

# Optional explicit model context capacity; otherwise use the local model lookup.
# MODEL_CONTEXT_WINDOW=1000000
# Purpose-specific overrides inherit each missing CHAT_* value.
# INTENT_MODEL=
# INTENT_BASE_URL=
# INTENT_API_KEY=
# SUMMARY_MODEL=
# SUMMARY_BASE_URL=
# SUMMARY_API_KEY=
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# Optional provider-specific reasoning controls.
# CHAT_THINKING=disabled
# CHAT_REASONING_EFFORT=low
# CHAT_REASONING_SPLIT=true

# The index requires 1024-dimensional embeddings.
EMBED_API_KEY=replace-me
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_MODEL=BAAI/bge-m3
# Reranking uses its own provider protocol rather than chat completions.
RERANK_API_KEY=replace-me
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
TOKEN_BUDGET=2000

# Persistent local services. Always use a separate disposable test database.
# DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/commerceagent
# TEST_DATABASE_URL=mysql+asyncmy://root:root@localhost:3306/commerceagent_test
# Override host ports and the matching client URLs together if needed.
# MYSQL_PORT=3307
# MILVUS_PORT=19531
# MILVUS_HEALTH_PORT=9092
# MILVUS_URI=http://localhost:19531
MILVUS_COLLECTION=knowledge_en_v1

MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
DEMO_TICKET_DELAY_SECONDS=0

# Optional traces. Local token accounting does not require Langfuse.
# LANGFUSE_PUBLIC_KEY=replace-with-your-langfuse-public-key
# LANGFUSE_SECRET_KEY=replace-with-your-langfuse-secret-key
# LANGFUSE_BASE_URL=http://localhost:3000
# These variables initialize missing resources; they do not update existing users.
# LANGFUSE_INIT_USER_EMAIL=admin@commerceagent.local
# LANGFUSE_INIT_USER_NAME=commerceagent
# LANGFUSE_INIT_USER_PASSWORD=replace-before-deployment

# Enable only after validating the English model, tokenizer, schema, and ONNX export.
TOPIC_CLASSIFIER_ENABLED=false
